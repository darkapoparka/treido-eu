new file mode 100644
--- /dev/null
+++ b/lib/guard.js
@@ -0,0 +1,53 @@
+'use strict';
+
+const { MAX_LENGTH } = require('./constants');
+
+// Local GHSA-vfj7-8cjw-p6xm mitigation, not an upstream release.
+const MAX_DEPTH = 100;
+const MAX_NODES = 2 * MAX_LENGTH + 3;
+const MAX_EXPANSION = 10000;
+const MAX_OUTPUT = 1000000;
+
+const fail = reason => {
+  throw new SyntaxError('Braces safety limit: ' + reason);
+};
+
+// Follow only child edges: normal parser parent/prev references are cyclic.
+// Count visits, not unique objects, to also bound shared-subtree amplification.
+const validate = ast => {
+  const active = new Set();
+  const stack = [{ node: ast, depth: -1, index: -1 }];
+  let count = 0;
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    const node = frame.node;
+    if (frame.index === -1) {
+      if (!node || typeof node !== 'object') fail('invalid AST node');
+      if (frame.depth > MAX_DEPTH) fail('AST depth');
+      if (++count > MAX_NODES) fail('AST node visits');
+      if (active.has(node)) fail('AST child cycle');
+      active.add(node);
+      if (node.nodes !== undefined && !Array.isArray(node.nodes)) fail('invalid children');
+      if (node.nodes && node.nodes.length > MAX_NODES) fail('AST node visits');
+      frame.index = 0;
+    }
+    if (node.nodes && frame.index < node.nodes.length) {
+      stack.push({ node: node.nodes[frame.index++], depth: frame.depth + 1, index: -1 });
+    } else {
+      active.delete(node);
+      stack.pop();
+    }
+  }
+};
+
+const expansion = values => {
+  if (values.length > MAX_EXPANSION) fail('expansion count');
+  let length = 0;
+  for (const value of values) {
+    length += value.length;
+    if (length > MAX_OUTPUT) fail('expansion characters');
+  }
+  return values;
+};
+
+module.exports = { MAX_DEPTH, MAX_EXPANSION, MAX_OUTPUT, fail, validate, expansion };
