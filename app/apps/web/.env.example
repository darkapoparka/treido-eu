# T04a configuration contract. Empty bindings intentionally fail validation.
# This does not enable providers or change the current guarded reference preview.
# Use an ignored .env.local in this directory; never copy donor credentials.
# NEXT_PUBLIC_* values are public. Only the Clerk publishable key belongs there.
TREIDO_ENV=development
TREIDO_DATA_MODE=database
# Real platform development uses an isolated output and a free non-reference port.
TREIDO_APP_ORIGIN=http://127.0.0.1:6419
# Provider-specific region IDs; review co-location before enabling an adapter.
TREIDO_APP_REGION=
TREIDO_CLERK_APP_ID=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
TREIDO_NEON_PROJECT_ID=
TREIDO_NEON_BRANCH_ID=
TREIDO_NEON_BRANCH_PURPOSE=development
TREIDO_DB_REGION=
TREIDO_DB_DATABASE=
TREIDO_DB_ROLE=
# Development-only fallback when a provider-managed login must enter as the restricted runtime role.
# Requires an unpooled endpoint and DATABASE_URL options=-c role=<TREIDO_DB_ROLE>. Never use in preview/production.
TREIDO_DB_LOGIN_ROLE=
TREIDO_DB_LOCAL_BRIDGE=false
DATABASE_URL=
# Privileged migrations are a separately reviewed path, never the runtime role.
MIGRATION_DATABASE_URL=
# Storage provider/bucket, Stripe and other services are bound by their own tasks.
# T04f: verified isolated Inngest target. Unconfigured jobs fail closed.
TREIDO_INNGEST_APP_ID=
INNGEST_ENV=
TREIDO_INNGEST_PURPOSE=development
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Cloud signature verification remains enabled even for a test application.
INNGEST_DEV=false
# Required locally: the confirmed HTTPS development tunnel's origin.
# Forward only /api/inngest; keep TREIDO_APP_ORIGIN local for Clerk and R2.
INNGEST_SERVE_ORIGIN=
TREIDO_OUTBOX_SERVICE_ID=
CRON_SECRET=
# Default retains Inngest's minute repair. Production-only external-minute
# additionally requires the authenticated Vercel minute cron, migration 0052,
# runtime function grant and treido/repair.requested event-key permission.
# Do not select external-minute before those activation checks are complete.
TREIDO_REPAIR_SCHEDULER=inngest-cron
# Optional distinct credential for reasoned dead-letter redrive, never public.
TREIDO_OUTBOX_REDRIVE_SECRET=
# T06b: private, verified EU R2 bucket and an isolated object prefix.
TREIDO_R2_ACCOUNT_ID=
TREIDO_R2_BUCKET=
TREIDO_R2_JURISDICTION=eu
TREIDO_R2_PURPOSE=development
TREIDO_R2_PREFIX=development-treido/
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Payments: existing intended account and TEST mode first; collection stays disabled.
# Private keys and a distinct registered endpoint signing secret are server-only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
TREIDO_STRIPE_MODE=test
TREIDO_STRIPE_PLATFORM_ACCOUNT=
TREIDO_STRIPE_APPLICATION_ID=
TREIDO_STRIPE_COLLECTION_ENABLED=false
STRIPE_WEBHOOK_SECRET=
TREIDO_STRIPE_WEBHOOK_ENDPOINT_ID=
TREIDO_STRIPE_WEBHOOK_SCOPE=platform
TREIDO_STRIPE_WEBHOOK_PLATFORM_ACCOUNT=
TREIDO_STRIPE_WEBHOOK_MODE=test
# Optional ONLY for local Development/test with TEST Stripe: bare public HTTPS origin.
# Its registered endpoint must be exactly <origin>/api/stripe/webhook. Browser
# TREIDO_APP_ORIGIN stays loopback; hosted Preview/Production reject this override.
# Leave this variable absent until a reachable, restricted callback is qualified.
# TREIDO_STRIPE_WEBHOOK_ORIGIN=https://<qualified-public-development-host>

# Public discovery pagination: a dedicated random 32-byte key, encoded as 64 hex characters.
# Set this separately in each deployed environment; do not reuse authentication keys.
TREIDO_DISCOVERY_CURSOR_KEY=

# T72 invitation mail: explicit bindings only; empty values disable delivery.
# Do not place these values in NEXT_PUBLIC_* variables or copy a donor account.
# APP_ID/JOB_ENV/ORIGIN must match the current Inngest application, environment
# and Treido application origin. Domain ID/name must be verified by Resend.
RESEND_API_KEY=
TREIDO_INVITATION_MAIL_ENV=
TREIDO_INVITATION_MAIL_APPLICATION_ID=
TREIDO_INVITATION_MAIL_JOB_ENV=
TREIDO_INVITATION_MAIL_ORIGIN=
TREIDO_INVITATION_MAIL_PURPOSE=team.invitation
TREIDO_INVITATION_MAIL_SENDER=
TREIDO_INVITATION_MAIL_DOMAIN=
TREIDO_INVITATION_MAIL_DOMAIN_ID=
TREIDO_INVITATION_MAIL_ACCOUNT_BINDING=
# Required outside production: comma-separated explicitly approved test inboxes.
TREIDO_INVITATION_MAIL_TEST_RECIPIENTS=
# Optional current-account email alerts reuse those qualified bindings with a
# distinct purpose. Rendering/sign-in never opts in; leave disabled initially.
TREIDO_NOTIFICATION_MAIL_ENABLED=0
# Message attachments reuse the verified private media adapter with a separate
# derived message-image prefix/scope. They never enable a public media bucket.

# AI Gateway authentication never enables a model or creates an approved policy.
# Hosted vercel-oidc requires exact approved team/project/environment identity;
# VERCEL_ORG_ID and VERCEL_PROJECT_ID must be available with verified values.
# Do not bind a persistent VERCEL_OIDC_TOKEN. Keep AI_GATEWAY_API_KEY absent
# when selecting vercel-oidc; the SDK would otherwise prefer the API key.
TREIDO_AI_GATEWAY_AUTH_MODE=api-key
AI_GATEWAY_API_KEY=
TREIDO_AI_GATEWAY_OIDC_ISSUER=
TREIDO_AI_GATEWAY_OIDC_AUDIENCE=
TREIDO_AI_GATEWAY_OIDC_SUBJECT=
