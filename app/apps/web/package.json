{
  "name": "@treido/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "dev:platform": "node --env-file-if-exists=.env.local scripts/dev-platform.mjs",
    "dev:preview": "node scripts/dev-preview.mjs",
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.build.json",
    "media:configure": "node --env-file-if-exists=.env.local scripts/configure-neon-media.mjs"
  },
  "dependencies": {
    "@clerk/localizations": "4.21.2",
    "@clerk/nextjs": "7.9.9",
    "@opentelemetry/api": "1.9.1",
    "@stripe/stripe-js": "10.0.0",
    "@treido/contracts": "workspace:*",
    "ai": "7.0.127",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.3",
    "inngest": "4.21.0",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
